# Copy to .env next to compose.yml for a fixed test address through Cloudflare Tunnel (docs/DEPLOY.md).
# Never commit the filled-in file: the token lets anyone run your tunnel.
COMPOSE_PROFILES=tunnel
TUNNEL_TOKEN=
RP_ID=mm.example.com
ORIGIN=https://mm.example.com
BEHIND_PROXY=1
# Optional: new accounts per hour from one address (default 10) and storage per account in MB (default 256).
# REGISTER_PER_HOUR=10
# QUOTA_MB=256
