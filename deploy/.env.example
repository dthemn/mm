# Copy to deploy/.env and fill in. Never commit the filled-in file.
# The domain must already point to this server's IP address (an A record).
DOMAIN=mm.example.com
# A long random password, for example from: openssl rand -hex 24
POSTGRES_PASSWORD=
# Optional: new accounts per hour from one address (default 10) and storage per account in MB (default 256).
# REGISTER_PER_HOUR=10
# QUOTA_MB=256
